# FinWise Backend Environment Configuration Template

# Application Environment (development | production | test)
APP_ENV=development

# Database URL
# Local Development SQLite:
DATABASE_URL=sqlite+aiosqlite:///./bank_analyzer.db
# Neon Serverless Postgres (Production / Cloud):
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon_pooler_host>/<dbname>?ssl=require

# Frontend URL (CORS allowed origins, comma-separated or *)
FRONTEND_URL=http://localhost:3000

# REST API prefix
API_PREFIX=/api/v1

# SARIMA Forecasting Configuration
DEFAULT_SARIMA_HORIZON=30
CONFIDENCE_ALPHA=0.10

# Category Classifier ML Model Path
CATEGORY_MODEL_PATH=backend/ml/artifacts/category_classifier.joblib
